                    "type": "boolean"
                },
                "language_id": {
                    "type": "integer"
                },
                "video_resolution_id": {
                    "type": "integer"
                },
                "video_type_id": {
                    "type": "integer"
                },
                "voice_type_id": {
                    "type": "integer"
                }
            }
        },
        "VideoPostBody": {
            "type": "object",
            "properties": {
                "embedded_advertisement": {
                    "description": "Specify `true` if video contains segment with advertisement.",
                    "type": "boolean"
                },
                "episode_id": {
                    "description": "CDNVideoHub Episode identifier if video is episode of serial.",
                    "type": "string"
                },
                "language_id": {
                    "description": "CDNVideoHub Language identifier for video.",
                    "type": "integer"
