                },
                "name": {
                    "description": "Segment name.",
                    "allOf": [
                        {
                            "$ref": "#/definitions/SkipName"
                        }
                    ]
                },
                "require": {
                    "description": "Force skip segment.",
                    "type": "boolean"
                },
                "start": {
                    "description": "Segment start in seconds.",
                    "type": "integer"
                }
            }
        },
        "SkipName": {
