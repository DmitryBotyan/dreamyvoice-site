                "title_id": {
                    "description": "CDNVideoHub Title identifier if video is movie.",
                    "type": "string"
                },
                "uploader": {
                    "description": "Name or id or email or something else data which you need to identify who uploaded the video.",
                    "type": "string"
                },
                "video_resolution_id": {
                    "description": "CDNVideoHub VideoResolution identifier for video.",
                    "type": "integer"
                },
                "video_type_id": {
                    "description": "CDNVideoHub VideoType identifier for video.",
                    "type": "integer"
                },
                "voice_studio_id": {
