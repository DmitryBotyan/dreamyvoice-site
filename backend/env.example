DATABASE_URL="postgresql://app:adminadmin@localhost:5432/app?schema=public"
PORT=4000

SESSION_COOKIE_NAME=session
SESSION_COOKIE_SECRET=exampleexampleexampleexample
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
SESSION_TTL_HOURS=720

PLAYER_ALLOWED_HOSTS=example.com

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1

S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin_pass

S3_FORCE_PATH_STYLE=true
S3_BUCKET_AVATARS=avatars
S3_BUCKET_COVERS=covers

# CDNVideoHub API для создания/загрузки видео (опционально; задавайте обе переменные вместе)
# CDN_VIDEOHUB_BASE_URL=https://api.cdnvideohub.example.com
# CDN_VIDEOHUB_TOKEN=your-bearer-token-here
# CDNVideoHub player URL для публичного воспроизведения по cvhVideoId (можно использовать отдельно от API)
# CDN_VIDEOHUB_PLAYER_BASE_URL=https://player.cdnvideohub.example.com/embed
