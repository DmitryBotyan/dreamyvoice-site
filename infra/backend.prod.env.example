# /opt/env/backend.prod.env — copy and fill on server, never commit

NODE_ENV=production
PORT=4000

DATABASE_URL=postgresql://app:POSTGRES_PASSWORD@db:5432/app?schema=public

SESSION_COOKIE_NAME=sid
SESSION_COOKIE_SECRET=change-me-min-32-chars-random-string
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=lax
SESSION_TTL_HOURS=720

PLAYER_ALLOWED_HOSTS=dreamyvoice.net,www.dreamyvoice.net

# MinIO (matches MINIO_ROOT_USER/PASSWORD from .env)
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=MINIO_ROOT_USER_VALUE
S3_SECRET_KEY=MINIO_ROOT_PASSWORD_VALUE
S3_BUCKET_AVATARS=avatars
S3_BUCKET_COVERS=covers
S3_FORCE_PATH_STYLE=true

APP_URL=https://dreamyvoice.net

# Optional SMTP
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# CDN VideoHub (optional, set both or neither)
CDN_VIDEOHUB_BASE_URL=
CDN_VIDEOHUB_TOKEN=
CDN_VIDEOHUB_PLAYER_BASE_URL=

RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key
